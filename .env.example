DB_HOST=db_host
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_name

PORT=8080

# JWT Secret
JWT_SECRET=secret
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=168h

# Root penyimpanan dokumen transaksi (attachment).
# Kosongkan untuk memakai default /app/documents — path di dalam container,
# sesuai volume di docker-compose.yml.
# Wajib diisi kalau backend dijalankan langsung di host (mis. Air di Windows),
# contoh: D:/freelance/rebuild_asset/backend-go/documents
ATTACHMENT_STORAGE_PATH=
